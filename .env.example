# ============================================================
# Student Management System - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ============================================================

# ── Backend (Spring Boot / Node) ─────────────────────────────

# MySQL Database (used when SPRING_PROFILES_ACTIVE=prod)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studentdb
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server port (default: 8080)
PORT=8080

# Spring profile: dev (H2 in-memory) | prod (MySQL)
SPRING_PROFILES_ACTIVE=dev

# CORS: comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (React) ─────────────────────────────────────────

# Backend API base URL (used in React build)
REACT_APP_API_BASE_URL=http://localhost:8080/api
